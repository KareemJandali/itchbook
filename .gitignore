# Build output
build/
build-*/
cmake-build-*/

# Output of scripts/real-data-run.sh. Derived from licensed data, so it is
# ignored for the same reason data/ is.
out/
compile_commands.json

# Market data — never commit (multi-GB, licensed).
# Ignore the contents, not the directories: excluding a directory outright
# means a fresh clone has nowhere to write, and every tool that opens a file
# under it fails.
data/raw/*
data/sliced/*
!data/raw/.gitkeep
!data/sliced/.gitkeep
*.gz

# Credentials — API keys belong in the environment, never in the tree
.env
*.key
.databento
secrets.json

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# Python
__pycache__/
*.pyc
.venv/
venv/
build-verify-gcc/
build-verify-clang/
