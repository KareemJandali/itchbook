# Build output
build/
build-*/
cmake-build-*/

# Output of scripts/real-data-run.sh. Derived from licensed data, so it is
# ignored for the same reason data/ is.
out/
compile_commands.json

# Market data — never commit (multi-GB, licensed).
# Ignore the contents, not the directories: excluding a directory outright
# means a fresh clone has nowhere to write, and every tool that opens a file
# under it fails.
data/raw/*
data/sliced/*
!data/raw/.gitkeep
!data/sliced/.gitkeep
*.gz

# Credentials — API keys belong in the environment, never in the tree
.env
*.key
.databento
secrets.json

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# Python
__pycache__/
*.pyc
.venv/
venv/
build-verify-gcc/
build-verify-clang/

# The phase 4 A/B pair. Two book_bench builds differing only in pool chunk
# sizing, rebuilt in seconds from the recipe in bench/README.md — the RESULTS
# they produced live in bench/perf-counters.txt and are committed, which is the
# part worth keeping. Anchored to the root because that is where the documented
# `-o bench_new` puts them, and a bare name would also ignore any directory of
# that name anywhere in the tree.
/bench_new
/bench_old
